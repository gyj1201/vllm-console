{
  "name": "vllm-console",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.2",
  "description": "从模型 config.json 解析 vLLM 启动参数的纯前端工具",
  "license": "MIT",
  "keywords": [
    "vllm",
    "llm",
    "vue",
    "vite",
    "typescript",
    "tailwindcss",
    "shadcn-vue"
  ],
  "engines": {
    "node": ">=22.15",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "tsc src/lib/vllm/sources.ts src/lib/vllm/mapper.ts --target es2022 --module esnext --outDir test/.build --skipLibCheck --ignoreConfig && node test/verify.mjs",
    "verify:clean": "node -e \"require('node:fs').rmSync('test/.build',{recursive:true,force:true})\"",
    "release": "npx bumpp"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.48.0",
    "@tanstack/vue-form": "^1.33.5",
    "@tanstack/vue-query": "^5.104.0",
    "@tanstack/vue-table": "^9.2.4",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dayjs": "^1.11.23",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "motion-v": "2.4.4",
    "nprogress": "^0.2.0",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.10.5",
    "universal-cookie": "^8.1.2",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-input-otp": "^0.4.0",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify-json/simple-icons": "^1.2.98",
    "@iconify/vue": "^5.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.0",
    "@types/node": "^26.6.3",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "happy-dom": "^20.14.5",
    "nano-staged": "^1.0.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.1",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
